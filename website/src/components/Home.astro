---
import CourseLink from './CourseLink.astro';
import SeatExplorer from './SeatExplorer.astro';
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
---
<div class="course-home">
  <section class="course-intro">
    <div class="intro-copy">
      <p class="course-kicker">{ru ? 'Открытый курс по тестированию ПО' : 'An open course in software testing'}</p>
      <CourseLink class="mobile-language" to={ru ? 'en/' : 'ru/'}>{ru ? 'English' : 'Русский'}</CourseLink>
      <h1 id="_top" data-page-title>{ru ? 'От требований к обоснованным выводам.' : 'From requirements to useful evidence.'}</h1>
      <p class="intro-lead">{ru ? 'Проследите путь продукта: требования, роли, жизненный цикл, тест-дизайн, дефекты и отчёты. Полная первая лекция по исходным PDF и записи.' : 'Follow a product through requirements, roles, delivery, test design, defects and reports. A full first lecture rebuilt from the original PDF and recording.'}</p>
      <div class="intro-actions">
        <CourseLink class="course-button" to={`${lang}/lessons/foundations/`}>{ru ? 'Начать урок' : 'Start the lesson'} <span aria-hidden="true">→</span></CourseLink>
        <CourseLink class="text-link" to={`slides/${lang}/foundations/`}>{ru ? 'Открыть слайды' : 'Open the slides'} <span aria-hidden="true">↗</span></CourseLink>
      </div>
      <dl class="lesson-facts"><div><dt>{ru ? 'Первый урок' : 'First lesson'}</dt><dd>{ru ? 'Основы тестирования' : 'Testing foundations'}</dd></div><div><dt>{ru ? 'Формат' : 'Format'}</dt><dd>{ru ? '2 × 75 мин + отдельная практика' : '2 × 75 min + separate lab'}</dd></div></dl>
    </div>
    <div class="supporting-example"><p class="course-kicker">{ru ? 'Дополнительная практика · Последнее место' : 'Supporting lab · The last seat'}</p><SeatExplorer lang={lang} /></div>
  </section>
  <section class="learning-path">
    <h2>{ru ? 'От бизнес-задачи к результатам' : 'From product goals to test evidence'}</h2>
    <div class="path-rows">
      <CourseLink to={`${lang}/lessons/foundations/`}><span class="path-number">01</span><div><h3>{ru ? 'Пройдите полную лекцию' : 'Explore the full lecture'}</h3><p>{ru ? '48 слайдов, полный текст и карта исходных материалов.' : '48 slides, complete reading and a map to the original sources.'}</p></div><span aria-hidden="true">→</span></CourseLink>
      <CourseLink to={`${lang}/labs/registration/`}><span class="path-number">02</span><div><h3>{ru ? 'Потренируйтесь на границе' : 'Practice on one boundary'}</h3><p>{ru ? 'Добавьте проверку границы, исправьте код и сохраните защиту от регрессии.' : 'Add a boundary test, fix the code, and keep the regression check.'}</p></div><span aria-hidden="true">→</span></CourseLink>
      <CourseLink to={`${lang}/lessons/foundations/` }><span class="path-number">03</span><div><h3>{ru ? 'Подготовьте 20 кейсов' : 'Prepare 20 test cases'}</h3><p>{ru ? 'Основное задание: план, осмысленные кейсы и честный отчёт.' : 'The main assignment: a plan, reasoned cases and an honest report.'}</p></div><span aria-hidden="true">→</span></CourseLink>
    </div>
  </section>
  <section class="course-note"><h2>{ru ? 'Два языка. Одна программа.' : 'Two languages. One course.'}</h2><p>{ru ? 'Для студентов с базовыми навыками программирования и начинающих QA-инженеров. Переключайте язык на любой странице: тема останется той же. Исходный код примеров одинаков для обеих версий.' : 'For students with basic programming skills and junior QA engineers. Switch languages on any page and stay on the same topic. Both versions use the same example code.'}</p><CourseLink to={`${lang}/course/`}>{ru ? 'Программа и материалы прошлых лет' : 'Explore the course map and archive'} →</CourseLink></section>
</div>
